[{"id":1791857638498,"text":"出国第二年就没联系了。","rawContent":"出国第二年就没联系了。","isHtml":false,"sticker":null,"sender":"them","time":"08:54","timestamp":1791852889533,"roundId":"round_1791852862257_iummdxn59","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":493},{"id":1791857638499,"text":"怎么突然问这个？","rawContent":"怎么突然问这个？","isHtml":false,"sticker":null,"sender":"them","time":"08:54","timestamp":1791852893167,"roundId":"round_1791852862257_iummdxn59","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":494},{"id":1791857638500,"text":"没…没什么","sender":"me","time":"08:54","timestamp":1791852897923,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":495},{"id":1791857638502,"text":"字都打结巴了，还说没什么。","rawContent":"字都打结巴了，还说没什么。","isHtml":false,"sticker":null,"sender":"them","time":"08:55","timestamp":1791852916954,"roundId":"round_1791852899025_5hlcio7fe","generatedMode":false,"hasThinking":true,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":496},{"id":1791857638503,"text":"是听到谁说了什么，还是单纯突然想起来？","rawContent":"是听到谁说了什么，还是单纯突然想起来？","isHtml":false,"sticker":null,"sender":"them","time":"08:55","timestamp":1791852922718,"roundId":"round_1791852899025_5hlcio7fe","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":497},{"id":1791857638504,"text":"我和他早就没瓜葛了。当年决定转赛车就彻底断了，是我自己的选择。","rawContent":"我和他早就没瓜葛了。当年决定转赛车就彻底断了，是我自己的选择。","isHtml":false,"sticker":null,"sender":"them","time":"08:55","timestamp":1791852940462,"roundId":"round_1791852899025_5hlcio7fe","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":498},{"id":1791857638505,"text":"在我这不用这么小心翼翼。你想问什么都可以直接问。","rawContent":"在我这不用这么小心翼翼。你想问什么都可以直接问。","isHtml":false,"sticker":null,"sender":"them","time":"08:55","timestamp":1791852947187,"roundId":"round_1791852899025_5hlcio7fe","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":499},{"id":1791852631124,"text":"举止轻佻，全无体统。七年过去，门第与教养的差距依然刻在骨子里...","sender":"me","timestamp":1791852962272,"isMomentForward":true,"momentData":{"id":1791849128103,"name":"周承德","note":"举止轻佻，全无体统。七年过去，门第与教养的差距依然刻在骨子里。离斯亦远一点，不要让我亲自提醒你第二次。","images":["https://localhost/_capacitor_file_/data/user/0/app.nuojiji.android/files/images/img_63d727ee-0378-4074-a1b7-e73a0fd52783.png"],"timestamp":1791848675912,"location":""},"isRead":false,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":500},{"id":1791857638506,"text":"我也明确回复叔叔 说和你是朋友…","sender":"me","time":"08:56","timestamp":1791852984332,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":501},{"id":1791857638507,"text":"你也别去和叔叔争论什么","sender":"me","time":"08:56","timestamp":1791853003967,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":502},{"id":1791857638509,"text":"把他删了。","rawContent":"把他删了。","isHtml":false,"sticker":null,"sender":"them","time":"08:56","timestamp":1791853016521,"roundId":"round_1791853004624_miv54gwh3","generatedMode":false,"hasThinking":true,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":503},{"id":1791857638510,"text":"微信、电话，所有能联系到你的方式，全部拉黑。","rawContent":"微信、电话，所有能联系到你的方式，全部拉黑。","isHtml":false,"sticker":null,"sender":"them","time":"08:57","timestamp":1791853027261,"roundId":"round_1791853004624_miv54gwh3","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":504},{"id":1791857638511,"text":"用不着回他任何话，一个字都不用回。更不用跟他说我们只是朋友。","rawContent":"用不着回他任何话，一个字都不用回。更不用跟他说我们只是朋友。","isHtml":false,"sticker":null,"sender":"them","time":"08:57","timestamp":1791853037406,"roundId":"round_1791853004624_miv54gwh3","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":505},{"id":1791857638512,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"08:57","timestamp":1791853039470,"roundId":"round_1791853004624_miv54gwh3","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"听话，别看他写的那些东西，一个标点符号都别往心里去。他没资格评价你，当年没有，现在更没有。这事跟你一点关系都没有，是我没把家里的烂摊子料理干净，让你受委屈了。我来处理，你别管。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"calm","translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":506},{"id":1791857638513,"text":"不用劝我，我和他早就没什么可争论的。","rawContent":"不用劝我，我和他早就没什么可争论的。","isHtml":false,"sticker":null,"sender":"them","time":"08:57","timestamp":1791853052639,"roundId":"round_1791853004624_miv54gwh3","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":507},{"id":1791857638514,"text":"但我不会允许任何人指着你的鼻子说这种话。","rawContent":"但我不会允许任何人指着你的鼻子说这种话。","isHtml":false,"sticker":null,"sender":"them","time":"08:57","timestamp":1791853060641,"roundId":"round_1791853004624_miv54gwh3","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":508},{"id":1791857638515,"text":"我不委屈…周斯亦 我只是不想你难过","sender":"me","time":"08:57","timestamp":1791853072301,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":509},{"id":1791857638517,"text":"傻不傻。","rawContent":"傻不傻。","isHtml":false,"sticker":null,"sender":"them","time":"08:58","timestamp":1791853091767,"roundId":"round_1791853073361_ah6zmtjib","generatedMode":false,"hasThinking":true,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":510},{"id":1791857638518,"text":"我早就不会因为他说什么难过了，真的。","rawContent":"我早就不会因为他说什么难过了，真的。","isHtml":false,"sticker":null,"sender":"them","time":"08:58","timestamp":1791853098327,"roundId":"round_1791853073361_ah6zmtjib","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":511},{"id":1791857638519,"text":"对我来说，他只是个有血缘关系的陌生人，他的评价在我这里没有任何分量。","rawContent":"对我来说，他只是个有血缘关系的陌生人，他的评价在我这里没有任何分量。","isHtml":false,"sticker":null,"sender":"them","time":"08:58","timestamp":1791853115294,"roundId":"round_1791853073361_ah6zmtjib","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":512},{"id":1791857638520,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"08:58","timestamp":1791853117391,"roundId":"round_1791853073361_ah6zmtjib","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"但你在我这有分量。你被他这么说，还反过来替我着想，我才会难受。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"fluent","translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":513},{"id":1791857638521,"text":"不用为了息事宁人去跟他解释我们是什么关系。","rawContent":"不用为了息事宁人去跟他解释我们是什么关系。","isHtml":false,"sticker":null,"sender":"them","time":"08:58","timestamp":1791853126536,"roundId":"round_1791853073361_ah6zmtjib","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":514},{"id":1791857638522,"text":"听我的，先把人删了。别看那些脏东西。","rawContent":"听我的，先把人删了。别看那些脏东西。","isHtml":false,"sticker":null,"sender":"them","time":"08:58","timestamp":1791853139608,"roundId":"round_1791853073361_ah6zmtjib","generatedMode":false,"subtext":"我舍不得让你受哪怕一点委屈","translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":515},{"id":1791857638523,"text":"我开完早会去接你，当面说。","rawContent":"我开完早会去接你，当面说。","isHtml":false,"sticker":null,"sender":"them","time":"08:59","timestamp":1791853143781,"roundId":"round_1791853073361_ah6zmtjib","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":516},{"id":1791857638524,"text":"接我？","sender":"me","time":"08:59","timestamp":1791853160083,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":517},{"id":1791857638525,"text":"你今天不忙别的了吗","sender":"me","time":"08:59","timestamp":1791853165914,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":518},{"id":1791857638527,"text":"早会十点半结束，中间有两个小时空档。","rawContent":"早会十点半结束，中间有两个小时空档。","isHtml":false,"sticker":null,"sender":"them","time":"09:00","timestamp":1791853221407,"roundId":"round_1791853208378_i1aggpwmk","generatedMode":false,"hasThinking":true,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":519},{"id":1791857638528,"text":"下午模拟器测试在两点半，耽误不了。","rawContent":"下午模拟器测试在两点半，耽误不了。","isHtml":false,"sticker":null,"sender":"them","time":"09:00","timestamp":1791853224192,"roundId":"round_1791853208378_i1aggpwmk","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"907266f8-b392-4fea-b335-10f45977f9bb","_id":520},{"id":1791857638529,"text":"昨晚某人不是还答应了，看在我的面子上带我体验上海？","rawContent":"昨晚某人不是还答应了，看在我的面子上带我体验上海？","isHtml":false,"sticker":null,"sender":"them","time":"09:00","timestamp":1791853230510,"roundId":"round_1791853208378_i1aggpwmk","generatedMode":false,"subtext":"别想找借口赖掉","translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId"