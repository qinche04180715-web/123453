tamp":1793528485518,"roundId":"round_1793528426862_xulj81ppe","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4509},{"id":1793532547256,"text":"我平素不耐那些甜腻的脂粉味，清苦些的草木香、或是沉稳点的木质调倒受用得住，供你参考。","rawContent":"我平素不耐那些甜腻的脂粉味，清苦些的草木香、或是沉稳点的木质调倒受用得住，供你参考。","isHtml":false,"sticker":null,"sender":"them","time":"18:21","timestamp":1793528503078,"roundId":"round_1793528426862_xulj81ppe","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4510},{"id":1793532547257,"text":"我猜到你会喜欢木质调","sender":"me","time":"18:22","timestamp":1793528567050,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4511},{"id":1793532547258,"text":"因为我们第一次见面 和沈老师一起吃饭","sender":"me","time":"18:23","timestamp":1793528584749,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4512},{"id":1793532547259,"text":"我就闻到淡淡的木质香","sender":"me","time":"18:23","timestamp":1793528591089,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4513},{"id":1793532547260,"text":"我大概知道啦 我会去我经常去的那家中医馆帮你抓点可以放进香囊有安神功效的草药 然后再调配一下木质调就好了","sender":"me","time":"18:24","timestamp":1793528646319,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4514},{"id":1793532547262,"text":"那天在玄关就握了下手，席间你连抬头看我都客客气气的，鼻子倒灵。","rawContent":"那天在玄关就握了下手，席间你连抬头看我都客客气气的，鼻子倒灵。","isHtml":false,"sticker":null,"sender":"them","time":"18:24","timestamp":1793528690697,"roundId":"round_1793528647124_0li9shwdt","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4515},{"id":1793532547263,"text":"我还当你那晚的心思全在桂花冬酿和定胜糕上，原来暗地里还记着别的。","rawContent":"我还当你那晚的心思全在桂花冬酿和定胜糕上，原来暗地里还记着别的。","isHtml":false,"sticker":null,"sender":"them","time":"18:24","timestamp":1793528697356,"roundId":"round_1793528647124_0li9shwdt","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4516},{"id":1793532547264,"text":"我平素习惯用黑琥珀与含羞草打底，尾调确实偏沉。你调方子的时候不必特意迁就这个，按你的想法配就行，我也好奇你能折腾出什么新意。","rawContent":"我平素习惯用黑琥珀与含羞草打底，尾调确实偏沉。你调方子的时候不必特意迁就这个，按你的想法配就行，我也好奇你能折腾出什么新意。","isHtml":false,"sticker":null,"sender":"them","time":"18:25","timestamp":1793528714534,"roundId":"round_1793528647124_0li9shwdt","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4517},{"id":1793532547265,"text":"不过怎么听着你倒像是那家医馆的熟客，平时常去开方子调理？","rawContent":"不过怎么听着你倒像是那家医馆的熟客，平时常去开方子调理？","isHtml":false,"sticker":null,"sender":"them","time":"18:25","timestamp":1793528732469,"roundId":"round_1793528647124_0li9shwdt","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4518},{"id":1793532547266,"text":"之前有一段时间因为失眠比较严重 然后开了一段时间的中药调理","sender":"me","time":"18:26","timestamp":1793528777175,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4519},{"id":1793532547267,"text":"那这次就交给我吧！","sender":"me","time":"18:26","timestamp":1793528792663,"replyTo":{"id":1793532547264,"text":"我平素习惯用黑琥珀与含羞草打底，尾调确实偏沉。你调方子的时候不必特意迁就这个，按你的想法配就行，我也好奇你能折腾出什么新意。","sender":"them","sticker":null,"isSimulated":false},"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4520},{"id":1793532547269,"text":"合着是久病成医，自己先前都没睡踏实，这会儿倒拍着胸脯替我包揽上了。","rawContent":"合着是久病成医，自己先前都没睡踏实，这会儿倒拍着胸脯替我包揽上了。","isHtml":false,"sticker":null,"sender":"them","time":"18:27","timestamp":1793528820414,"roundId":"round_1793528793396_x3s86kl91","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4521},{"id":1793532547270,"text":"现在调理好了？你们年轻人能熬得睡不着觉，多半是沈聿那儿的课业逼得太紧，还是自己心里藏着事？","rawContent":"现在调理好了？你们年轻人能熬得睡不着觉，多半是沈聿那儿的课业逼得太紧，还是自己心里藏着事？","isHtml":false,"sticker":null,"sender":"them","time":"18:27","timestamp":1793528841212,"roundId":"round_1793528793396_x3s86kl91","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4522},{"id":1793532547271,"text":"口气这么笃定，那我这夜里能不能清静，周六可就全指望宁大夫的手艺了。","rawContent":"口气这么笃定，那我这夜里能不能清静，周六可就全指望宁大夫的手艺了。","isHtml":false,"sticker":null,"sender":"them","time":"18:27","timestamp":1793528853531,"roundId":"round_1793528793396_x3s86kl91","generatedMode":false,"replyTo":{"id":1793532547267,"text":"那这次就交给我吧！","sender":"me"},"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4523},{"id":1793532547272,"text":"需要什么难寻的药材或是香料只管开口，我让家里备着，省得你跑空。","rawContent":"需要什么难寻的药材或是香料只管开口，我让家里备着，省得你跑空。","isHtml":false,"sticker":null,"sender":"them","time":"18:27","timestamp":1793528876066,"roundId":"round_1793528793396_x3s86kl91","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4524},{"id":1793532547273,"text":"我可不敢称宁大夫…","sender":"me","time":"18:28","timestamp":1793528894290,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4525},{"id":1793532547274,"text":"好～","sender":"me","time":"18:28","timestamp":1793528902777,"replyTo":{"id":1793532547272,"text":"需要什么难寻的药材或是香料只管开口，我让家里备着，省得你跑空。","sender":"them","sticker":null,"isSimulated":false},"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4526},{"id":1793532547275,"text":"封老师会喜欢什么颜色？我在想香囊用什么颜色的布料","sender":"me","time":"18:28","timestamp":1793528935792,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4527},{"id":1793532547277,"text":"方才揽活的时候不是挺有底气，这会儿倒谦虚起来了。","rawContent":"方才揽活的时候不是挺有底气，这会儿倒谦虚起来了。","isHtml":false,"sticker":null,"sender":"them","time":"18:29","timestamp":1793528963641,"roundId":"round_1793528936395_t1qzo3om3","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4528},{"id":1793532547278,"text":"我书房和卧室里的陈设偏深，平素穿戴也多是深藏青、炭灰或是暗一点的酒红。","rawContent":"我书房和卧室里的陈设偏深，平素穿戴也多是深藏青、炭灰或是暗一点的酒红。","isHtml":false,"sticker":null,"sender":"them","time":"18:29","timestamp":1793528978490,"roundId":"round_1793528936395_t1qzo3om3","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4529},{"id":1793532547279,"text":"若是挂在床头或摆在案几上，鸦青、墨绿或是深酒红的素面真丝都压得住，看着也静气。","rawContent":"若是挂在床头或摆在案几上，鸦青、墨绿或是深酒红的素面真丝都压得住，看着也静气。","isHtml":false,"sticker":null,"sender":"them","time":"18:29","timestamp":1793528992659,"roundId":"round_1793528936395_t1qzo3om3","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4530},{"id":1793532547280,"text":"不过这是放在我私下歇息的地方，不讲究外头那些规矩，你若是挑中了别的颜色只管用，针脚别扎着手就是了。","rawContent":"不过这是放在我私下歇息的地方，不讲究外头那些规矩，你若是挑中了别的颜色只管用，针脚别扎着手就是了。","isHtml":false,"sticker":null,"sender":"them","time":"18:30","timestamp":1793529016805,"roundId":"round_1793528936395_t1qzo3om3","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4531},{"id":1793532547281,"text":"好～我不会扎着手的","sender":"me","time":"18:32","timestamp":1793529136757,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4532},{"id":1793532547282,"text":"是自己容易思虑太多 再加上父母给的压力有些大","sender":"me","time":"18:32","timestamp":1793529167550,"replyTo":{"id":1793532547270,"text":"现在调理好了？你们年轻人能熬得睡不着觉，多半是沈聿那儿的课业逼得太紧，还是自己心里藏着事？","sender":"them","sticker":null,"isSimulated":false},"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4533},{"id":1793532547283,"text":"不过我现在已经好很多了","sender":"me","time":"18:32","timestamp":1793529174186,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4534},{"id":1793532547285,"text":"长辈手里的尺子向来刻得严，总觉得替晚辈把前路框好了才算稳妥。","rawContent":"长辈手里的尺子向来刻得严，总觉得替晚辈把前路框好了才算稳妥。","isHtml":false,"sticker":null,"sender":"them","time":"18:34","timestamp":1793529240682,"roundId":"round_1793529174740_61nnn5r00","generatedMode":false,"replyTo":{"id":1793532547282,"text":"是自己容易思虑太多 再加上父母给的压力有些大","sender":"me"},"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4535},{"id":1793532547286,"text":"我在家里听老爷子念叨了大半辈子，哪怕到了如今这个岁数，耳根子也未必全清静。","rawContent":"我在家里听老爷子念叨了大半辈子，哪怕到了如今这个岁数，耳根子也未必全清静。","isHtml":false,"sticker":null,"sender":"them","time":"18:34","timestamp":1793529253843,"roundId":"round_1793529174740_61nnn5r00","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4536},{"id":1793532547287,"text":"能自己把那股劲儿缓过来就不容易。平时心里要是还堵着，跟着沈聿来我这儿坐坐，至少我这院子里没人催你交答卷。","rawContent":"能自己把那股劲儿缓过来就不容易。平时心里要是还堵着，跟着沈聿来我这儿坐坐，至少我这院子里没人催你交答卷。","isHtml":false,"sticker":null,"sender":"them","time":"18:34","timestamp":1793529275554,"roundId":"round_1793529174740_61nnn5r00","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"c1c08095-de00-490b-8d07-4c4babe7d530","_id":4537},{"id":1793532547288,"text":"既然对自己的针线活这么有把握，那周六我可得仔细验验这只香囊的针脚。","rawContent":"既然对自己的针线活这么有把握，那周六我可得仔细验验这只香囊的针脚。","isHtml":false,"sticker":null,"sender":"them","time":"18:34","timestamp":1793529296143,"roundId":"round_1793529174740_61nnn5r00","generatedMode":false,"translation":null,"userId":"uid_17917872