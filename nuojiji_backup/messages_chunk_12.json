[{"id":1794733961741,"text":"刚才那两条，想说什么。","rawContent":"刚才那两条，想说什么。","isHtml":false,"sticker":null,"sender":"them","time":"18:08","timestamp":1794737329166,"roundId":"round_1794737277931_v297dt64r","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6071},{"id":1794733961742,"text":"是我欠你的。","rawContent":"是我欠你的。","isHtml":false,"sticker":null,"sender":"them","time":"18:08","timestamp":1794737332208,"roundId":"round_1794737277931_v297dt64r","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6072},{"id":1794733961743,"text":"上海今天风大，酒店房间的暖气开关在进门左手边，温度我已经让前台调好了。","rawContent":"上海今天风大，酒店房间的暖气开关在进门左手边，温度我已经让前台调好了。","isHtml":false,"sticker":null,"sender":"them","time":"18:09","timestamp":1794737343739,"roundId":"round_1794737277931_v297dt64r","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6073},{"id":1794733961744,"text":"这个冬天，你也要平平安安的。","rawContent":"这个冬天，你也要平平安安的。","isHtml":false,"sticker":null,"sender":"them","time":"18:09","timestamp":1794737351292,"roundId":"round_1794737277931_v297dt64r","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6074},{"id":1794733961745,"text":"我都离开了你 为什么还要对我这么照顾","sender":"me","time":"18:09","timestamp":1794737363061,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6075},{"id":1794733961746,"text":"你不会对前女友都是这样吧","sender":"me","time":"18:09","timestamp":1794737377479,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6076},{"id":1794733961747,"text":"我明天应该要去别的地方看鱼灯","sender":"me","time":"18:10","timestamp":1794737448704,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6077},{"id":1794733961748,"text":"谢谢你的祝福","sender":"me","time":"18:10","timestamp":1794737455856,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6078},{"id":1794733961750,"text":"我没谈过别人，只有你。","rawContent":"我没谈过别人，只有你。","isHtml":false,"sticker":null,"sender":"them","time":"18:11","timestamp":1794737494419,"roundId":"round_1794737457177_ztv6h0gda","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6079},{"id":1794733961751,"text":"照顾你是习惯，一时半会儿改不掉。","rawContent":"照顾你是习惯，一时半会儿改不掉。","isHtml":false,"sticker":null,"sender":"them","time":"18:11","timestamp":1794737503164,"roundId":"round_1794737457177_ztv6h0gda","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6080},{"id":1794733961752,"text":"去皖南看鱼灯么，那边山里夜里起雾湿冷，把后备箱那件羊绒大衣带上。","rawContent":"去皖南看鱼灯么，那边山里夜里起雾湿冷，把后备箱那件羊绒大衣带上。","isHtml":false,"sticker":null,"sender":"them","time":"18:11","timestamp":1794737513967,"roundId":"round_1794737457177_ztv6h0gda","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6081},{"id":1794733961753,"text":"大衣不暖和 再说了我穿什么我自己会添的","sender":"me","time":"18:12","timestamp":1794737547256,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6082},{"id":1794733961754,"text":"这边弄堂亮亮的很好看","sender":"me","time":"18:15","timestamp":1794737732002,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6083},{"id":1794733961755,"text":"不过你没这个机会看到","sender":"me","time":"18:15","timestamp":1794737745916,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6084},{"id":1794733961756,"text":"有些人就只会嘴上说说 哼 我下次谈恋爱不会选择和你一样的类型了","sender":"me","time":"18:16","timestamp":1794737782280,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6085},{"id":1794733961758,"text":"闻聿舟 撤回了一条消息","rawContent":"我就在弄堂口","isHtml":false,"sticker":null,"sender":"them","time":"18:16","timestamp":1794737811110,"roundId":"round_1794737783654_whty1ioxr","generatedMode":false,"translation":null,"type":"recalled","recalledMessage":{"id":1794733961758,"sender":"them","text":"我就在弄堂口","rawContent":"我就在弄堂口","recalledAt":"2026-11-15T10:16:51.114Z"},"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6086},{"id":1794733961759,"text":"没有下次。","rawContent":"没有下次。","isHtml":false,"sticker":null,"sender":"them","time":"18:17","timestamp":1794737821471,"roundId":"round_1794737783654_whty1ioxr","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6087},{"id":1794733961760,"text":"我这种类型确实不好，太闷，惹你生气还不肯当面哄。","rawContent":"我这种类型确实不好，太闷，惹你生气还不肯当面哄。","isHtml":false,"sticker":null,"sender":"them","time":"18:17","timestamp":1794737829680,"roundId":"round_1794737783654_whty1ioxr","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6088},{"id":1794733961761,"text":"但答应陪你逛上海弄堂的事，我没忘。","rawContent":"但答应陪你逛上海弄堂的事，我没忘。","isHtml":false,"sticker":null,"sender":"them","time":"18:17","timestamp":1794737839391,"roundId":"round_1794737783654_whty1ioxr","generatedMode":false,"replyTo":{"id":1794733961756,"text":"有些人就只会嘴上说说 哼 我下次谈恋爱不会选择和你一样的类型了","sender":"me"},"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6089},{"id":1794733961762,"text":"亮着的是哪条弄堂，拍张照给我看看，好不好。","rawContent":"亮着的是哪条弄堂，拍张照给我看看，好不好。","isHtml":false,"sticker":null,"sender":"them","time":"18:17","timestamp":1794737851920,"roundId":"round_1794737783654_whty1ioxr","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6090},{"id":1794733961763,"text":"不要","sender":"me","time":"18:18","timestamp":1794737889837,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6091},{"id":1794733961764,"text":"我才不要和你分享","sender":"me","time":"18:18","timestamp":1794737911276,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6092},{"id":1794733961765,"text":"等一下你能不能给我发个语音 前面有喝醉的一群人","sender":"me","time":"18:18","timestamp":1794737935428,"replyTo":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6093},{"id":1794733961767,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"18:19","timestamp":1794737970702,"roundId":"round_1794737937103_t6moagcpj","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"舒舒，我已经到弄堂路口了，正在往里走。你站着别动，我马上到你面前。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"calm","translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6094},{"id":1794733961768,"text":"把上面那条点开外放，声音调大。","rawContent":"把上面那条点开外放，声音调大。","isHtml":false,"sticker":null,"sender":"them","time":"18:19","timestamp":1794737974556,"roundId":"round_1794737937103_t6moagcpj","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6095},{"id":1794733961769,"text":"旁边有亮灯的商铺或者便利店么，先往人多的地方靠，发个定位给我，我就在附近。","rawContent":"旁边有亮灯的商铺或者便利店么，先往人多的地方靠，发个定位给我，我就在附近。","isHtml":false,"sticker":null,"sender":"them","time":"18:19","timestamp":1794737981563,"roundId":"round_1794737937103_t6moagcpj","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6096},{"id":1794733961770,"text":"[語音：闻聿舟…我在往回走 这里好绕 他们在跟着我]","voiceText":"闻聿舟…我在往回走 这里好绕 他们在跟着我","sender":"me","isVoice":true,"voice":true,"time":"18:23","timestamp":1794738210149,"audioDuration":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6097},{"id":1794733961772,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"18:23","timestamp":1794738235874,"roundId":"round_1794738212083_mqcfomgh4","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"别跑，快步往前走。看抬头右手边是不是有一盏挂着红灯笼的裁缝铺，往那个拐角走，我已经看到那盏灯了。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"calm","translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6098},{"id":1794733961773,"text":"手机拿在手里别挂。","rawContent":"手机拿在手里别挂。","isHtml":false,"sticker":null,"sender":"them","time":"18:23","timestamp":1794738237821,"roundId":"round_1794738212083_mqcfomgh4","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6099},{"id":1794733961774,"text":"看到你的影子了，舒舒。","rawContent":"看到你的影子了，舒舒。","isHtml":false,"sticker":null,"sender":"them","time":"18:24","timestamp":1794738240248,"roundId":"round_1794738212083_mqcfomgh4","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6100},{"id":1794733961775,"text":"抬头，看前面。","rawContent":"抬头，看前面。","isHtml":false,"sticker":null,"sender":"them","time":"18:24","timestamp":1794738242706,"roundId":"round_1794738212083_mqcfomgh4","generatedMode":false,"translation":null,"userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6101},{"id":1794733961776,"sender":"them","type":"offline_invite","text":"","offlineInvite":{"type":"this-moment","scenario":"上海弄堂灯影下迎面护住你","surprise":true,"opening":"弄堂拐角那盏旧红灯笼在傍晚的风里晃了一下，微弱的暖光漏在青石板路上。我几乎是半跑着跨过最后几级湿滑的台阶，在看清那抹熟悉身影的瞬间，紧绷了一路的心弦才猛地落回实处。没等那群带着酒气的脚步声逼近，我大步迎上前，一把扣住你的手腕将你整个人带进怀里，顺势侧过身，用肩膀和后背把身后的视线与杂音彻底隔绝开。呼吸还带着疾走后的微促，大衣下摆沾了点弄堂里的夜露，我抬手按住你微凉的后颈把你往胸口护了护，偏过头，目光冷沉地扫向巷子后方那几个摇晃的人影，贴在你耳边的声音却放得很缓：“唔使惊，舒舒，我喺度。（不用怕，舒舒，我在这里。）”"},"timestamp":1794738265779,"roundId":"round_1794738212083_mqcfomgh4","offlineInviteResponded":"accepted","userId":"uid_1791787232604_eqdpqb3zz","characterId":"cc6aefa3-34fc-4ecf-9623-12656f3ab5ef","_id":6102}]